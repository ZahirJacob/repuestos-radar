# repuestos-radar environment variables.
# Copy this file to .env and fill in real values.
# Real values are NEVER committed — .env is gitignored.

# MercadoLibre application credentials (https://developers.mercadolibre.com.ar/)
MELI_CLIENT_ID=your-meli-app-id
MELI_CLIENT_SECRET=your-meli-app-secret

# Postgres connection string (Neon/Supabase free tier), e.g.
# postgresql://user:password@host:5432/dbname
DATABASE_URL=postgresql://user:password@host:5432/repuestos_radar

# Shared password for the whole dashboard (Streamlit Cloud reads it from secrets instead)
APP_PASSWORD=change-me

# Shop coordinates for distances on the dashboard (keep the real values out of the repo)
# SHOP_LAT=
# SHOP_LON=
